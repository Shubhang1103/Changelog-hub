    {
      "name": "2. Public Changelog & Feeds",
      "item": [
        {
          "name": "Get Public Changelog Timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog?category=All&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["changelog"],
              "query": [
                { "key": "category", "value": "All" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Changelog with Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog?q=semantic",
              "host": ["{{baseUrl}}"],
              "path": ["changelog"],
              "query": [
                { "key": "q", "value": "semantic" }
              ]
            }
          }
        },
        {
          "name": "Get Single Changelog by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/{{changelogSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "{{changelogSlug}}"]
            }
          }
        },
        {
          "name": "Get Public JSON Feed for Widgets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/changelog/feed?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["changelog", "feed"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
