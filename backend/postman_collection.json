    },
    {
      "name": "5. Admin Publishing Studio (Protected)",
      "item": [
        {
          "name": "List All Entries (Draft + Published)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/changelog?status=All&category=All",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog"],
              "query": [
                { "key": "status", "value": "All" },
                { "key": "category", "value": "All" }
              ]
            }
          }
        },
        {
          "name": "Create Changelog Entry (Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode Theme & Accessibility Enhancements\",\n  \"slug\": \"dark-mode-theme-accessibility-enhancements\",\n  \"contentMarkdown\": \"### Dark Mode is Finally Here!\\n\\nEnjoy high-contrast dark mode tailored for late-night coding.\\n\\n- Seamless system preference detection\\n- Accessible WCAG AAA contrast ratios\",\n  \"category\": \"New\",\n  \"status\": \"Draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/changelog",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog"]
            }
          }
        },
        {
          "name": "Get Changelog Entry by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/changelog/{{changelogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog", "{{changelogId}}"]
            }
          }
        },
        {
          "name": "Update Changelog Entry",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode Theme & High Contrast Colors\",\n  \"category\": \"Improved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/changelog/{{changelogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog", "{{changelogId}}"]
            }
          }
        },
        {
          "name": "Toggle / Set Publish Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/changelog/{{changelogId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog", "{{changelogId}}", "publish"]
            }
          }
        },
        {
          "name": "Delete Changelog Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/changelog/{{changelogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "changelog", "{{changelogId}}"]
            }
          }
        }
