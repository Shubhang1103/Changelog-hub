# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/changelog_hub

# JWT Secrets & Expirations (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=changelog_jwt_access_secret_super_secure_key_2026_xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changelog_jwt_refresh_secret_super_secure_key_2026_abc
JWT_REFRESH_EXPIRES_IN=7d

# Email Verification & Reset Simulation (true = log to console & include link in dev response)
EMAIL_SIMULATION=true

# Initial Admin User Credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Super Admin
